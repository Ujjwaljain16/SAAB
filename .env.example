# Scaler Credentials
# Option 1: Provide them here for automatic login
# Option 2: Leave blank and log in manually via Google/Email when running 'npm run auth'
SCALER_EMAIL=
SCALER_PASS=

# AI Provider Configuration (At least one is required)
# Google Gemini
GEMINI_API_KEY=
# Or comma-separated list of Gemini keys for round-robin pool (recommended for high volume):
# GEMINI_API_KEYS=key1,key2,key3
# Gemini model to use (default: gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview

# Groq (Ultra fast Llama-3.3-70b / Qwen — free tier available)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Multiple Groq fallback models (tried in order):
GROQ_MODELS=llama-3.3-70b-versatile,qwen/qwen3-32b

# xAI Grok (Optional fallback)
GROK_API_KEY=
GROK_MODEL=grok-beta

# Performance & Concurrency
SOLVE_CONCURRENCY=4
MAX_OUTPUT_TOKENS=4096
# Minimum milliseconds between AI API calls (increase if hitting rate limits)
API_SPACING_MS=2200

# Filtering — comma-separated subject name fragments (leave blank = solve ALL subjects)
# TARGET_SUBJECTS=DevOps,Computer Networks

# Flags (can also be passed as CLI args)
# SKIP_LABS=true      # Skip Maxwell container/terminal labs
# ONLY_MCQ=true       # Only solve MCQ problems

# Safety: stop after N submissions in one run (0 = unlimited; or pass --max-submissions=N)
# MAX_SUBMISSIONS=0

# Scaler allows max 3 active logins. If the "Session limit reached" page appears, true = SAAB logs out the OLDEST session itself
# (may sign out one of your real devices). Default: you click "Logout Session" yourself.
# SCALER_AUTO_LOGOUT_OLDEST=false

# Gemini FREE tier has a small per-minute AND per-day request limit. If you see rate-limit messages, raise the gap between calls
# (e.g. 6000-12000) and/or lower SOLVE_CONCURRENCY. Several GEMINI_API_KEYS from different projects multiply the allowance.
# API_SPACING_MS=8000

# ─── Rate limits (how SAAB avoids 429s) ───
# Google enforces limits per PROJECT, not per API key, and daily limits reset at midnight Pacific time. The free-tier numbers are
# not on the docs page (see AI Studio for YOUR model) and Google says they are "not guaranteed", so set these to what AI Studio shows.
# Extra keys only add capacity if they belong to DIFFERENT projects.
# GEMINI_RPM=10   # max requests per minute, per key (default 10)
# GEMINI_RPD=0    # max requests per day, per key. 0 = unknown/unlimited. Set it to stop BEFORE the daily limit is hit.
# GROQ_RPM=25
# GROK_RPM=20
